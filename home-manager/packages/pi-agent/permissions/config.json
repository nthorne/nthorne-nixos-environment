{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "forwardingTimeoutMs": 600000,
  "piInfrastructureReadPaths": [],
  "shellTools": {},
  "authorizerChain": [],
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },

    "external_directory": {
      "*": "ask",
      "/tmp/*": "allow"
    },
    "external_directory_read": {
      "*": "ask",
      "/nix/store/*": "allow",
      "/mnt/c/Dev/*": "allow"
    },

    "read": "allow",
    "write": "ask",
    "edit": "ask",

    "bash": {
      "git *": "ask",
      "git branch *": "allow",
      "git diff *": "allow",
      "git grep *": "allow",
      "git log *": "allow",
      "git ls-tree *": "allow",
      "git rev-list *": "allow",
      "git rev-parse *": "allow",
      "git show *": "allow",
      "git status *": "allow",

      "cd *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "file *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "hunk *": "allow",
      "ls *": "allow",
      "pwd *": "allow",
      "readlink *": "allow",
      "rg *": "allow",
      "sort *": "allow",
      "tail *": "allow",
      "true": "allow",
      "wc *": "allow",
      "which *": "allow",

      "rm *": "ask",
      "rm -rf *": "ask",

      "sudo *": "ask"
    },

    "skill": { "*": "allow" },

    "ask_user_question": "allow",
    "get_search_content": "allow",

    "memory_add": "allow",
    "memory_remove": "allow",
    "memory_replace": "allow",
    "memory_search": "allow",

    "todo": "allow",

    "symbol_search": "allow",
    "web_search": "allow",

    "fetch_content": "allow",
    "ctx_search": "allow",
    "ctx_fetch_and_index": "allow"
  }
}
