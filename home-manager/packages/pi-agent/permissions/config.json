{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "forwardingTimeoutMs": 600000,
  "piInfrastructureReadPaths": [],
  "shellTools": {},
  "authorizerChain": [],
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "read": "allow",
    "write": "ask",
    "edit": "ask",
    "bash": {
      "git *": "ask",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git status *": "allow",

      "cat *": "allow",
      "echo *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "tail *": "allow",

      "rm *": "ask",
      "rm -rf *": "ask",

      "sudo *": "ask"
    },
    "mcp": { "mcp_status": "allow" },
    "skill": { "*": "allow" },

    "ctx_search": "allow",
    "ctx_fetch_and_index": "allow",
    "fetch_content": "allow",

    "external_directory": "ask"
  }
}
